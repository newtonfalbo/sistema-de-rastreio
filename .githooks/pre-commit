#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if [ -n "${RASTREIO_PYTHON:-}" ]; then
    python_bin=$RASTREIO_PYTHON
elif [ -f "$root/.venv/Scripts/python.exe" ]; then
    python_bin="$root/.venv/Scripts/python.exe"
elif [ -x "$root/.venv/bin/python" ]; then
    python_bin="$root/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    python_bin=python3
elif command -v python >/dev/null 2>&1; then
    python_bin=python
else
    echo "Python indisponivel; commit nao verificado. Configure o ambiente local." >&2
    exit 2
fi
exec "$python_bin" "$root/scripts/verificar-publicacao.py"
